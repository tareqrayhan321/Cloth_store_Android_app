<resources>
    <!-- Compose পুরোপুরি নিজের থিম হ্যান্ডেল করে; এটা শুধু ল্যাঞ্চার/ম্যানিফেস্টের জন্য বেস থিম -->
    <style name="Theme.ImranClothStore" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#00363a</item>
        <item name="android:windowBackground">#ffffff</item>
    </style>

    <!-- খোলার মুহূর্তের (Android SplashScreen API) থিম: গোল লোগোর স্থির স্প্ল্যাশ বাদ —
         শুধু সাদা পট, তারপর সরাসরি EMEAN মোশন ইন্ট্রো; শেষে Theme.ImranClothStore-এ ফেরে -->
    <style name="Theme.ImranClothStore.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/emean_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.ImranClothStore</item>
    </style>
</resources>
