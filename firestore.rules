rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // মালিকের ডিভাইস (তারেকের ফোন, v1.1.4-এ নিবন্ধিত)।
    function isOwner() {
      return request.auth != null && request.auth.uid == 'c7ohrewCZZbzqeyE0UJc22Dpm1K2';
    }

    // বৈধ ব্যবহারকারী: মালিক নিজে, অথবা যার devices ডকে valid == true বসানো আছে।
    // নতুন কাউকে বৈধ করতে শুধু তার devices/{uid} ডকে valid: true বসালেই হয় —
    // অ্যাপ আপডেট লাগে না।
    function isValidUser() {
      return isOwner() || (
        request.auth != null
        && exists(/databases/$(database)/documents/devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.get('valid', false) == true
      );
    }

    // ডিভাইস নিবন্ধন: যেকোনো সাইন-ইন করা ডিভাইস শুধু নিজের ডকটাই লিখতে/পড়তে পারবে।
    match /devices/{deviceId} {
      allow get, create, update: if request.auth != null && request.auth.uid == deviceId;
    }

    // লেনদেনের ডাটা (v1.1.6 থেকে): সাইন-ইন করা সবাই পড়তে ও লিখতে পারবে।
    // এই ডকে মোবাইল নাম্বার থাকে না — অ্যাপ সবসময় নাম্বারছাড়া push করে।
    match /imran_store/backup {
      allow read, write: if request.auth != null;
    }

    // মোবাইল নাম্বার: শুধু বৈধ ব্যবহারকারীরা পড়তে/লিখতে পারবে।
    match /imran_store/contacts {
      allow read, write: if isValidUser();
    }

    // বাকি সবকিছু: শুধু মালিক
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
